{
  "name": "axure-prototype-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP server exposing an Axure prototype as structural, spatial, visual and interaction context for any MCP host.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "axure-prototype-mcp": "./bin/axure-mcp.mjs"
  },
  "main": "./dist/server.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node bin/axure-mcp.mjs",
    "http": "node bin/axure-mcp.mjs --http --port 3333",
    "test": "node scripts/unittest.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:interaction": "node scripts/test-interaction.mjs && node scripts/test-interaction-source.mjs",
    "test:inpage": "node scripts/test-inpage.mjs",
    "test:e2e": "node scripts/selftest.mjs",
    "test:http": "node scripts/httptest.mjs",
    "test:all": "npm test && npm run test:security && npm run test:interaction && npm run test:inpage && npm run test:e2e && npm run test:http",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
