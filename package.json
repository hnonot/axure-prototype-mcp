{
  "name": "axure-prototype-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP server that exposes Axure prototypes as combined structural, spatial and visual context for MCP agents.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "axure-prototype-mcp": "./bin/axure-mcp.mjs"
  },
  "main": "./dist/server.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node bin/axure-mcp.mjs",
    "http": "node bin/axure-mcp.mjs --http --port 3333",
    "test": "node scripts/unittest.mjs",
    "test:e2e": "node scripts/selftest.mjs",
    "test:http": "node scripts/httptest.mjs",
    "test:all": "npm test && npm run test:e2e && npm run test:http",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
