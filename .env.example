# Axure Prototype MCP — configuration
#
# Every value below is optional and shows the built-in default, so the server runs
# without this file. Copy it to `.env` only if you need to change something.

# Project share URL. Origin and project path are split from it.
AXURE_URL=https://axure.example.com/ProjectB

# Browser.
AXURE_HEADLESS=true
AXURE_VIEWPORT_WIDTH=1440
AXURE_VIEWPORT_HEIGHT=900
# Fixed at browser-context creation; restart the server to change it.
AXURE_DEVICE_SCALE_FACTOR=1

# Timeouts. The internal Axure host can be slow, so both default generously.
AXURE_NAV_TIMEOUT_MS=60000
AXURE_SETTLE_MS=4000

# Output budgets.
AXURE_MAX_OUTLINE_NODES=1200
AXURE_OUTLINE_CHAR_BUDGET=48000

# Close the pooled Chromium after this much idle time.
AXURE_BROWSER_IDLE_MS=300000

# Hosts that must bypass an ambient HTTP(S) proxy. Internal Axure deployments are
# normally unreachable through a corporate proxy.
AXURE_NO_PROXY=axure.example.com,localhost,127.0.0.1,::1

# Base directory for the `savePath` argument of axure_get_visual.
AXURE_SCREENSHOT_DIR=.axure-mcp/shots

# Set to 1 for verbose stderr logging (stdout is reserved for the MCP channel).
# AXURE_DEBUG=1

# Only used by `--http`.
AXURE_HTTP_PORT=7458
AXURE_HTTP_HOST=127.0.0.1
