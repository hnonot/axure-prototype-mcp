# Axure Prototype MCP — configuration template
#
# THIS FILE IS NOT READ. The server reads `.env` (same directory, or the nearest one
# above it). Copy this file to `.env` and edit that one:
#
#     cp .env.example .env      # then edit .env
#
# Editing this template has no effect on the running server, which is a mistake the
# 0.2.2 release exists to make impossible: the server now loads `.env` implicitly at
# startup and fails fast when AXURE_URL is missing, instead of silently falling back
# to a built-in address.
#
# EVERY key below takes effect when it is set in `.env`. The single exception is
# AXURE_ENV_FILE, which is read from the process environment because it decides which
# file to open — the file cannot point at itself. `scripts/test-config.mjs` asserts this
# list stays complete and effective.

# ---------------------------------------------------------------------------
# REQUIRED. There is no default: a built-in address used to serve the wrong
# prototype with no error. Set this to the Axure share/publish URL of the
# prototype you want to read.
#
# To read a DIFFERENT prototype for one conversation, leave this as your usual
# project and call the `axure_use_prototype` tool with the other address — that
# needs no file edit and no restart.
# ---------------------------------------------------------------------------
AXURE_URL=https://axure.example.com/MyProject

# Extra hosts the browser may visit, comma separated. Needed only when a prototype
# embeds assets from another origin. A prototype address supplied at runtime through
# `axure_use_prototype` does NOT need to be listed here: it is verified instead.
AXURE_ALLOWED_HOSTS=

# Explicit path to a .env file, instead of searching this directory and up to seven parents.
# PROCESS ENVIRONMENT ONLY: set it in the shell or the host's env block. A value inside
# `.env` cannot apply, because this is the variable that chooses which file to read.
# AXURE_ENV_FILE=./ci.env

# Browser.
AXURE_HEADLESS=true
AXURE_VIEWPORT_WIDTH=1440
AXURE_VIEWPORT_HEIGHT=900
# Fixed at browser-context creation; restart the server to change it.
AXURE_DEVICE_SCALE_FACTOR=1
# Ceiling for the auto-enlarged capture viewport. A canvas larger than this is captured scaled,
# so the warning in the result explains it rather than silently mismatching the page map.
AXURE_MAX_CAPTURE_VIEWPORT_WIDTH=3840
AXURE_MAX_CAPTURE_VIEWPORT_HEIGHT=2160

# Timeouts. The internal Axure host can be slow, so both default generously.
AXURE_NAV_TIMEOUT_MS=60000
# Per in-page operation, independent of navigation. Raise it for a very large page.
AXURE_OPERATION_TIMEOUT_MS=20000
# Extra wait after `load`, for Axure's own bootstrapping scripts.
AXURE_SETTLE_MS=4000

# Output budgets.
AXURE_MAX_OUTLINE_NODES=1200
AXURE_OUTLINE_CHAR_BUDGET=48000
# Ceiling on the number of widget ids one call may name.
AXURE_MAX_WIDGET_IDS=40
# Cap on model widgets read when reading interactions (interaction data is far sparser).
AXURE_MAX_INTERACTION_WIDGETS=400
# Cap on pages returned by one axure_list_pages call.
AXURE_MAX_PAGES=500

# Close the pooled Chromium after this much idle time.
AXURE_BROWSER_IDLE_MS=300000

# Hosts that must bypass an ambient HTTP(S) proxy. Internal Axure deployments are
# normally unreachable through a corporate proxy.
AXURE_NO_PROXY=localhost,127.0.0.1,::1

# Base directory for the `savePath` argument of axure_get_visual.
AXURE_SCREENSHOT_DIR=.axure-mcp/shots

# Diagnostic verbosity on stderr: debug | info | warn | error.
# stdout is reserved for the MCP channel, so logs never go there.
AXURE_LOG_LEVEL=info

# Only used by `--http`. Command-line flags (--port, --host) still win over these.
AXURE_HTTP_PORT=3333
AXURE_HTTP_HOST=127.0.0.1
# REQUIRED whenever AXURE_HTTP_HOST is not a loopback address; at least 16 characters.
# Clients must then send `Authorization: Bearer <token>`.
# AXURE_HTTP_TOKEN=
